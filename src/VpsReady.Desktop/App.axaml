<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             x:Class="VpsReady.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F6FB" />
    <SolidColorBrush x:Key="InkBrush" Color="#17243A" />
    <SolidColorBrush x:Key="MutedInkBrush" Color="#61718B" />
    <SolidColorBrush x:Key="LineBrush" Color="#DCE4EF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2367D9" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B53F4F" />
  </Application.Resources>
  <Application.Styles>
    <themes:FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="26" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="TextBlock.field-hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E8F0FC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.nav TextBlock">
      <Setter Property="Foreground" Value="#E8F0FC" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#263C60" />
      <Setter Property="Foreground" Value="#E8F0FC" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#263C60" />
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock">
      <Setter Property="Foreground" Value="#E8F0FC" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#EAF2FF" />
      <Setter Property="Foreground" Value="#14243D" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#EAF2FF" />
    </Style>
    <Style Selector="Button.nav.selected TextBlock">
      <Setter Property="Foreground" Value="#14243D" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover">
      <Setter Property="Background" Value="#EAF2FF" />
      <Setter Property="Foreground" Value="#14243D" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EAF2FF" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover TextBlock">
      <Setter Property="Foreground" Value="#14243D" />
    </Style>
    <Style Selector="Button.nav:focus">
      <Setter Property="BorderBrush" Value="#E5B64B" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#14243D" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
