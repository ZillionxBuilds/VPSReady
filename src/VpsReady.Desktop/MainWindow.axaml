<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:application="using:VpsReady.Application"
        x:Class="VpsReady.Desktop.MainWindow"
        x:DataType="application:AppViewModel"
        Width="720"
        Height="360"
        Title="VPSReady">
  <StackPanel Margin="32" Spacing="12">
    <TextBlock FontSize="28" Text="{Binding Title}" />
    <TextBlock Text="{Binding Status}" />
  </StackPanel>
</Window>
