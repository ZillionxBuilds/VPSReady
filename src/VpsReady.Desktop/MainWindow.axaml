<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:application="using:VpsReady.Application"
        x:Class="VpsReady.Desktop.MainWindow"
        x:DataType="application:AppViewModel"
        Width="1040"
        Height="680"
        MinWidth="680"
        MinHeight="480"
        Title="{Binding Title}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="24,18" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" />
          <TextBlock AutomationProperties.Name="Connection status" Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" IsVisible="{Binding HasStartupFailure}" Background="{DynamicResource SystemControlErrorTextForegroundBrush}" CornerRadius="4" Padding="10,6">
          <TextBlock Foreground="White" FontWeight="SemiBold" Text="Safe limited state" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="240,*">
      <Border Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" Spacing="4">
            <TextBlock Margin="12,8,12,4" FontWeight="SemiBold" Text="Navigation" />
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="application:ShellNavigationItem">
                  <Button HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Command="{Binding NavigateCommand}"
                          ToolTip.Tip="{Binding Hint}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock IsVisible="{Binding IsSelected}" FontWeight="SemiBold" Text="Selected" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="760" Spacing="18">
          <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SelectedPage.Heading}" TextWrapping="Wrap" />
          <TextBlock FontSize="16" Text="{Binding SelectedPage.Description}" TextWrapping="Wrap" />
          <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Action unavailable" />
              <Button IsEnabled="{Binding SelectedPage.IsActionAvailable}" HorizontalAlignment="Left" Content="{Binding SelectedPage.UnavailableAction}" />
              <TextBlock Text="{Binding SelectedPage.UnavailableReason}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border IsVisible="{Binding ConnectionOverview}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Connection and overview" />
              <TextBlock Text="{Binding ConnectionOverview.Status}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ConnectionOverview.State}" />
              <TextBlock IsVisible="{Binding ConnectionOverview.OperationId}" FontFamily="Consolas" Text="{Binding ConnectionOverview.OperationId}" TextWrapping="Wrap" />
              <TextBlock Text="Remote facts are Unknown until an authenticated refresh completes; this screen never invents server values." TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding ConnectionOverview.RefreshCommand}" Content="Refresh connection state" />
                <Button Command="{Binding ConnectionOverview.DisconnectCommand}" Content="Disconnect" />
              </StackPanel>
              <TextBlock Text="Use Activity &amp; Diagnostics to Copy Safe Issue Report; credentials, raw host data and raw command output are never shown there." TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border IsVisible="{Binding SelectedPage.IsActivityPage}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="Local Activity &amp; Diagnostics" />
              <TextBlock Text="Activity is redacted before display and stored only on this device. VPSReady never uploads diagnostics automatically." TextWrapping="Wrap" />
              <TextBox Watermark="Filter safe activity" Text="{Binding ActivityDiagnostics.Filter}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding ActivityDiagnostics.RefreshCommand}" Content="Refresh activity" />
                <Button Command="{Binding ActivityDiagnostics.ClearCommand}" Content="Clear diagnostics" />
                <Button Command="{Binding ActivityDiagnostics.OpenFolderCommand}" Content="Open log folder" />
                <Button Command="{Binding ActivityDiagnostics.CopySafeIssueReportCommand}" Content="Copy Safe Issue Report" />
                <Button Command="{Binding ActivityDiagnostics.ExportSanitizedSupportBundleCommand}" Content="Export Sanitized Support Bundle" />
              </StackPanel>
              <TextBlock Text="{Binding ActivityDiagnostics.Status}" TextWrapping="Wrap" />
              <TextBlock FontFamily="Consolas" Text="{Binding ActivityDiagnostics.LogDirectory}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ActivityDiagnostics.Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4,0,4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Action}" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock FontFamily="Consolas" Text="{Binding OperationId}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border IsVisible="{Binding HasStartupFailure}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Startup was limited safely" />
              <TextBlock Text="Restart VPSReady. If this persists, use the local diagnostics folder when it becomes available and include only a Safe Issue Report." TextWrapping="Wrap" />
              <TextBlock FontFamily="Consolas" Text="{Binding StartupErrorId}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="Disconnected-first shell — remote actions remain unavailable until their verified workflow is ready." TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
